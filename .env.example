# Lynn's Blog 部署配置模板：复制为 .env 后修改，切勿把真实密码提交到 Git
#   cp .env.example .env

# MySQL root 密码（生产务必改成强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥（务必改成足够长的随机字符串，否则可被伪造登录态）
JWT_SECRET=please-change-to-a-long-random-secret-string-2026

# 前端对外端口（默认 8080，可用 http://IP:8080 直接访问）
HTTP_PORT=8080

# ---------- 以下为可选：阿里云 OSS 图片托管，不填则上传存本地卷 ----------
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
OSS_URL_PREFIX=

# ---------- 以下为可选：GitHub 贡献热力图抓取 ----------
# 本机用 Watt 等加速器（MITM 自签证书）访问 GitHub 时设 true，否则贡献图接口会报"连接 GitHub 失败"
# 公网服务器可直连 GitHub，保持 false；同时记得删除 docker-compose.yml 里 backend 的 extra_hosts 段
GITHUB_INSECURE_TLS=false
